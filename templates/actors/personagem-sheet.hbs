          <label>

            <span>
              Profeta
            </span>

            <input
              type="number"
              name="system.progressao.classes.profeta"
              value="{{system.progressao.classes.profeta}}"
              min="0"
              max="10"
            >

          </label>

        </div>

      </section>


      

      <div class="breu-official-lower-grid">


        

        <section class="breu-official-benefits">

          <h2>
            Benefícios de Classe
          </h2>


          <div class="breu-benefit-lines">

            <label>
