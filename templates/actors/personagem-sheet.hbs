          </div>

        </div>


        

        <div class="breu-official-stats">


          <div class="breu-official-stat breu-official-bp">

            <span>
              Bônus de Proficiência
            </span>

            <strong>
              +{{system.bp}}
            </strong>

          </div>


          <div class="breu-official-stat breu-official-ca">

            <span>
              CA
            </span>

            <strong>
              {{ca.total}}
            </strong>

            <small>
              10 + DES + Proteções
            </small>

          </div>


          <label class="breu-official-stat breu-official-movement">

            <span>
              Deslocamento
            </span>

            <input
              class="breu-official-movement-input"
              type="text"
              name="system.deslocamento"
              value="{{system.deslocamento}}"
              placeholder="Normal"
            >

          </label>


          <div class="breu-official-stat breu-official-pv">

            <span>
              PV
            </span>


            <div>

              <input
                type="number"
                name="system.vida.value"
                value="{{system.vida.value}}"
                min="0"
              >

              <b>
                /
              </b>

              <input
                type="number"
                name="system.vida.max"
                value="{{system.vida.max}}"
                min="0"
              >

            </div>

          </div>


          <div class="breu-official-stat breu-official-dv">

            <span>
              Dados de Vida
            </span>

            <strong>
              {{system.dv.resumo}}
            </strong>


            <div class="breu-official-dv-used">


              {{#if system.dv.d4.total}}

                <label>

                  <small>
                    d4 usados
                  </small>

                  <input
                    type="number"
                    name="system.dadosVida.usadosD4"
                    value="{{system.dadosVida.usadosD4}}"
                    min="0"
                    max="{{system.dv.d4.total}}"
                  >

                </label>

              {{/if}}


              {{#if system.dv.d8.total}}

                <label>

                  <small>
                    d8 usados
                  </small>

                  <input
                    type="number"
                    name="system.dadosVida.usadosD8"
                    value="{{system.dadosVida.usadosD8}}"
                    min="0"
                    max="{{system.dv.d8.total}}"
                  >

                </label>

              {{/if}}

            </div>

          </div>

