                placeholder="Anotação"
              >

            </div>

          </div>

        </section>

      </div>


      

      <section class="breu-official-heritage-mechanics">

        <h2>
          Herança
        </h2>


        <div class="breu-official-heritage-grid">


          <label>

            <span>
              Benefício I
            </span>

            <textarea
              name="system.heranca.beneficio1"
              rows="2"
            >{{system.heranca.beneficio1}}</textarea>

          </label>


          <label>

            <span>
              Benefício II
            </span>

            <textarea
              name="system.heranca.beneficio2"
              rows="2"
            >{{system.heranca.beneficio2}}</textarea>

          </label>


          <label>

            <span>
              Complicação
            </span>

            <textarea
