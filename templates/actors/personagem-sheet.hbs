<div class="breu-personagem">

  

  <div
    class="breu-sheet-mode-toggle"
    role="group"
    aria-label="Modo da ficha"
  >

    <button
      type="button"
      class="breu-sheet-mode-button"
      data-mode="play"
      title="Modo de jogo"
    >

      <i class="fa-solid fa-dice-d20"></i>

      <span>
        Jogar
      </span>

    </button>


    <button
      type="button"
      class="breu-sheet-mode-button"
      data-mode="edit"
      title="Editar ficha"
    >

      <i class="fa-solid fa-pen"></i>

      <span>
        Editar
      </span>

    </button>

  </div>


  

  <header class="breu-official-header">


    

    <div class="breu-official-identity breu-official-identity-left">

      <div
        class="breu-character-portrait-wrap"
        title="Imagem do personagem"
      >

        <img
          class="breu-character-portrait"
          src="{{actor.img}}"
          alt="{{actor.name}}"
          data-action="editImage"
          data-edit="img"
        >

        <span class="breu-character-portrait-edit">

          <i class="fa-solid fa-image"></i>

        </span>

      </div>


      <label class="breu-official-line breu-field-name">

        <span>
          Nome
        </span>

        <input
          type="text"
          name="name"
          value="{{actor.name}}"
          placeholder="Nome do personagem"
        >

      </label>


      <label class="breu-official-line">

        <span>
          Eu sou um(a)
        </span>

        <input
          type="text"
          name="system.antecedente.sou"
          value="{{system.antecedente.sou}}"
          placeholder="Quem você era?"
        >

      </label>


      <label class="breu-official-line">

        <span>
          Bom(a) em
        </span>

        <input
          type="text"
          name="system.antecedente.bomEm"
          value="{{system.antecedente.bomEm}}"
          placeholder="No que você é bom?"
        >

      </label>


      <label class="breu-official-line">

        <span>
          Em busca de
        </span>

        <input
          type="text"
          name="system.antecedente.emBuscaDe"
          value="{{system.antecedente.emBuscaDe}}"
          placeholder="O que você procura?"
        >

      </label>

    </div>


    

    <div class="breu-official-logo">

      <img
        src="systems/breu/assets/logo-breu.png"
        alt="BREU"
      >

    </div>


    

    <div class="breu-official-identity breu-official-identity-right">


      <div class="breu-official-top-row">

        <div class="breu-official-class-summary">

          <span>
            Classe
          </span>


          <div>

            {{#if system.progressao.classes.arcanista}}

              <b>
                Arcanista {{system.progressao.classes.arcanista}}
              </b>

            {{/if}}


            {{#if system.progressao.classes.combatente}}

              <b>
                Combatente {{system.progressao.classes.combatente}}
              </b>

            {{/if}}


            {{#if system.progressao.classes.especialista}}

              <b>
                Especialista {{system.progressao.classes.especialista}}
              </b>

            {{/if}}


            {{#if system.progressao.classes.profeta}}

              <b>
                Profeta {{system.progressao.classes.profeta}}
              </b>

            {{/if}}


            {{#unless system.nivel}}

              <b>
                Nível Zero
              </b>

            {{/unless}}

          </div>

        </div>


        <label class="breu-official-xp">

          <span>
            XP
          </span>

          <input
            type="number"
            name="system.progressao.xp"
            value="{{system.progressao.xp}}"
            min="0"
          >

        </label>

      </div>


      <label class="breu-official-line">

        <span>
          Herança
        </span>

        <input
          type="text"
          name="system.heranca.nome"
          value="{{system.heranca.nome}}"
          placeholder="Sua Herança"
        >

      </label>


      <div class="breu-official-line breu-official-appearance-preview">

        <span>
          Aparência
        </span>

        <div class="breu-official-preview-text">

          {{#if system.heranca.descricao}}

            {{system.heranca.descricao}}

          {{else}}

            <em>
              Sem descrição.
            </em>

          {{/if}}

        </div>

      </div>

    </div>

  </header>


  

  <nav
    class="breu-tabs"
    role="tablist"
  >

    <button
      type="button"
      class="breu-tab-button {{#if tabs.geral}}is-active{{/if}}"
      data-tab="geral"
      role="tab"
      aria-selected="{{tabs.geral}}"
    >

      <i class="fa-solid fa-user"></i>

      <span>
        Geral
      </span>

    </button>


    <button
      type="button"
      class="breu-tab-button {{#if tabs.inventario}}is-active{{/if}}"
      data-tab="inventario"
      role="tab"
      aria-selected="{{tabs.inventario}}"
    >

      <i class="fa-solid fa-suitcase"></i>

      <span>
        Inventário
      </span>

    </button>


    <button
      type="button"
      class="breu-tab-button {{#if tabs.magia}}is-active{{/if}}"
      data-tab="magia"
      role="tab"
      aria-selected="{{tabs.magia}}"
    >

      <i class="fa-solid fa-wand-magic-sparkles"></i>

      <span>
        Magia
      </span>

    </button>


    <button
      type="button"
      class="breu-tab-button {{#if tabs.anotacoes}}is-active{{/if}}"
      data-tab="anotacoes"
      role="tab"
      aria-selected="{{tabs.anotacoes}}"
    >

      <i class="fa-solid fa-book-open"></i>

      <span>
        Anotações
      </span>

    </button>

  </nav>


  

  <div class="breu-tab-content">


    

    <div
      class="breu-tab-panel {{#if tabs.geral}}is-active{{/if}}"
      data-tab="geral"
    >


      

      <section class="breu-official-core">

        <div class="breu-official-attributes">


          

          <div class="breu-official-attribute">

            <div class="breu-official-attribute-title">

              <small>
