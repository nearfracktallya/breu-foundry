        </section>


        

        <section class="breu-official-debilities">

          <div class="breu-official-debility-title">

            <h2>
              Debilidades
            </h2>

            <strong>
              {{system.estadoDebilidades.quantidade}} / 5
            </strong>

          </div>


          <div class="breu-official-debility-consequence">

            <span>
              Consequência atual
            </span>

            <strong>
              {{system.estadoDebilidades.efeito}}
            </strong>

          </div>


          <div class="breu-official-debility-list">


            <div class="breu-official-debility-row">

              <b>
                1
              </b>

              <select name="system.debilidades.d1.tipo">

                <option
                  value="nenhuma"
                  {{#if (eq system.debilidades.d1.tipo "nenhuma")}}selected{{/if}}
                >
                  —
                </option>

                <option
                  value="leve"
                  {{#if (eq system.debilidades.d1.tipo "leve")}}selected{{/if}}
                >
                  Leve
                </option>

                <option
                  value="pesada"
                  {{#if (eq system.debilidades.d1.tipo "pesada")}}selected{{/if}}
                >
                  Pesada
                </option>

                <option
                  value="permanente"
                  {{#if (eq system.debilidades.d1.tipo "permanente")}}selected{{/if}}
                >
                  Permanente
                </option>

              </select>

              <input
                type="text"
                name="system.debilidades.d1.fonte"
                value="{{system.debilidades.d1.fonte}}"
                placeholder="Anotação"
              >

            </div>


