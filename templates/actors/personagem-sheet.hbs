          <span>
            Classes
          </span>

          <small>
            Nível total {{system.nivel}}
          </small>

        </div>


        <div class="breu-class-editor-grid">


          <label>

            <span>
              Arcanista
            </span>

            <input
              type="number"
              name="system.progressao.classes.arcanista"
              value="{{system.progressao.classes.arcanista}}"
              min="0"
              max="10"
            >

          </label>


          <label>

            <span>
              Combatente
            </span>

            <input
              type="number"
              name="system.progressao.classes.combatente"
