              </strong>

            </div>


            <input
              class="breu-official-attribute-value"
              type="number"
              name="system.atributos.for"
              value="{{system.atributos.for}}"
              min="-5"
              max="5"
            >


            <div class="breu-official-tr">

              <label>

                <input
                  type="checkbox"
                  name="system.resistencias.for"
                  {{checked system.resistencias.for}}
                >

                <span>
                  TR
                </span>

              </label>


              <button
                type="button"
                class="tr-roll"
                data-attribute="for"
              >
                {{system.tr.for}}
              </button>

            </div>

          </div>


          

          <div class="breu-official-attribute">

            <div class="breu-official-attribute-title">

              <small>
