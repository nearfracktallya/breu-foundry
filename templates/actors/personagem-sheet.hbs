                    class="breu-inventory-item-quantity"
                    title="Quantidade"
                  >

                    {{quantidade}}×

                  </span>


                  <span
                    class="breu-inventory-item-load"
                    title="Carga"
                  >

                    C {{carga}}

                  </span>


